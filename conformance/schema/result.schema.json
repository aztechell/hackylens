{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HackyLens conformance result v1",
  "type": "object",
  "required": ["schema_version", "manifest", "manifest_sha256", "suite_sha256", "requirements", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest": {"$ref": "implementation_manifest.schema.json"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "suite_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "object", "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}
    }},
    "requirement": {"type": "object", "required": ["id", "scope", "status", "scenarios", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^([A-Z]+-)+[0-9]{2}$"},
        "scope": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "NOT RUN", "NOT APPLICABLE"]},
        "scenarios": {"type": "array", "items": {"type": "string", "pattern": "^CT-[0-9]{2}$"}},
        "reason": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {"required": ["evidence"], "properties": {
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }}
    },
    "scenario": {"type": "object", "required": ["id", "coverage", "covered_observations", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^CT-[0-9]{2}$"},
        "coverage": {"enum": ["partial", "full"]},
        "covered_observations": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {"type": "object", "required": ["id", "status"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "status": {"enum": ["PASS", "FAIL", "NOT RUN"]},
      "evidence": {"$ref": "#/$defs/evidence"},
      "reason": {"type": "string", "minLength": 1}
    },
    "if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}},
    "then": {"required": ["evidence"]},
    "else": {"required": ["reason"]}}
  }
}
